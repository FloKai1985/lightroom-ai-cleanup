# Copy to .env and adjust as needed. All values have safe local defaults.

# SQLite database file used by the analysis service.
LR_CLEANUP_DATABASE_URL=sqlite:///./data/lr_cleanup.db

# Directory where the Lightroom plugin's temporary JPEG renditions are cached.
# Never point this at a Lightroom catalog or originals folder.
LR_CLEANUP_CACHE_DIR=./data/render_cache

# HTTP service bind address. Must stay on loopback — never change to 0.0.0.0.
LR_CLEANUP_HOST=127.0.0.1
LR_CLEANUP_PORT=8765

# Current analysis pipeline version. Bumping this invalidates cached results
# so photos are re-analyzed on the next job.
LR_CLEANUP_ANALYSIS_VERSION=1

# --- Similarity / grouping thresholds (see docs/algorithms.md) ---
LR_CLEANUP_BURST_WINDOW_SECONDS=10
LR_CLEANUP_PHASH_MAX_DISTANCE=8

# blur_confidence at/above which a photo is a high-confidence blur
# candidate. Also excludes the photo from near-duplicate/burst grouping —
# see docs/algorithms.md §2. Keep in sync with
# lightroom-plugin/AICleanup.lrplugin/ReviewResults.lua's
# HIGH_CONFIDENCE_BLUR_THRESHOLD constant if you change this.
LR_CLEANUP_HIGH_CONFIDENCE_BLUR_THRESHOLD=0.75

# --- Keeper ranking weights (must sum to 1.0) ---
LR_CLEANUP_WEIGHT_SHARPNESS=0.55
LR_CLEANUP_WEIGHT_EXPOSURE=0.25
LR_CLEANUP_WEIGHT_TECHNICAL=0.10
LR_CLEANUP_WEIGHT_EXISTING_PREFERENCE=0.10

LR_CLEANUP_LOG_LEVEL=INFO
